---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;

const navItems = [
  { label: 'About', href: '/about/', pastel: 'rose' },
  { label: 'Activities', href: '/activities/', pastel: 'peach' },
  { label: 'Downloads', href: '/downloads/', pastel: 'butter' },
  { label: 'News & events', href: '/news/', pastel: 'mint', matchPrefix: ['/news', '/events'] },
  { label: 'VR gallery', href: '/gallery/', pastel: 'sky' },
  { label: 'Contact', href: '/contact/', pastel: 'lilac' },
];

function isCurrent(item: typeof navItems[number]) {
  if (item.matchPrefix) {
    return item.matchPrefix.some((p) => pathname.startsWith(p));
  }
  return pathname.startsWith(item.href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="home-link" aria-label="CREATE & CARE — Home">
      <Logo size={48} showWordmark={true} />
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      id="menu-toggle-btn"
    >
      <span class="menu-toggle-label">Menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" class="menu-icon">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const active = isCurrent(item);
          return (
            <li>
              <a
                href={item.href}
                class:list={['nav-pill', `pill--${item.pastel}`, active && 'is-active']}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const nav = document.getElementById('primary-nav');

  if (toggleBtn && nav) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open', !expanded);
    });
  }
</script>

<style>
  .site-header {
    background-color: var(--paper);
    border-bottom: var(--border-thick);
    padding-block: 1rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .home-link {
    text-decoration: none;
    color: var(--plum);
    display: inline-flex;
    align-items: center;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    background-color: var(--butter);
    color: var(--plum);
    border: var(--border-thick);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
  }

  .menu-toggle[aria-expanded="true"] {
    background-color: var(--plum);
    color: var(--paper);
    box-shadow: var(--shadow-hard-sm);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 2px solid var(--plum);
    font-weight: 700;
    font-size: 0.96rem;
    text-decoration: none;
    color: var(--plum);
    line-height: 1.2;
  }

  .pill--rose { background-color: var(--rose); }
  .pill--peach { background-color: var(--peach); }
  .pill--butter { background-color: var(--butter); }
  .pill--mint { background-color: var(--mint); }
  .pill--sky { background-color: var(--sky); }
  .pill--lilac { background-color: var(--lilac); }

  .nav-pill:hover {
    color: var(--plum);
    box-shadow: 4px 4px 0 var(--plum);
    transform: translate(-1px, -1px);
  }

  .nav-pill.is-active {
    box-shadow: var(--shadow-hard);
    border-width: 2.5px;
    font-weight: 800;
  }

  @media (max-width: 880px) {
    .menu-toggle {
      display: inline-flex;
    }

    .primary-nav {
      width: 100%;
    }

    /* When JS runs on phones, allow toggle disclosure; also keep accessible if JS is off */
    :global(.js-enabled) .primary-nav:not(.is-open) {
      display: none;
    }

    .nav-list {
      padding-top: 0.75rem;
      gap: 0.5rem;
    }
  }
</style>
