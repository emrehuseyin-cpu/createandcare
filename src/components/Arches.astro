---
interface Props {
  variant?: 'hero' | 'banner';
  photoCaption?: string;
}

const { variant = 'hero', photoCaption = 'Photo slot (awaits consented workshop photo)' } = Astro.props;
---

{variant === 'hero' ? (
  <div class="arches-hero" aria-hidden="true">
    <svg viewBox="0 0 460 500" class="arches-svg">
      <!-- Concentric striped arch shells: rose -> peach -> butter -> mint -> lilac -->
      <path
        d="M 10 490 L 10 230 A 220 220 0 0 1 450 230 L 450 490 Z"
        fill="var(--rose)"
        stroke="var(--plum)"
        stroke-width="3"
      />
      <path
        d="M 38 490 L 38 235 A 192 192 0 0 1 422 235 L 422 490 Z"
        fill="var(--peach)"
        stroke="var(--plum)"
        stroke-width="3"
      />
      <path
        d="M 66 490 L 66 240 A 164 164 0 0 1 394 240 L 394 490 Z"
        fill="var(--butter)"
        stroke="var(--plum)"
        stroke-width="3"
      />
      <path
        d="M 94 490 L 94 245 A 136 136 0 0 1 366 245 L 366 490 Z"
        fill="var(--mint)"
        stroke="var(--plum)"
        stroke-width="3"
      />
      <path
        d="M 122 490 L 122 250 A 108 108 0 0 1 338 250 L 338 490 Z"
        fill="var(--lilac)"
        stroke="var(--plum)"
        stroke-width="3"
      />
      <!-- Inner photo slot cut into an arch shape -->
      <path
        d="M 148 472 L 148 256 A 82 82 0 0 1 312 256 L 312 472 Z"
        fill="var(--paper)"
        stroke="var(--plum)"
        stroke-width="2.5"
        stroke-dasharray="7 5"
      />
      <!-- Simple retro illustration placeholder inside arch slot -->
      <circle cx="230" cy="245" r="24" fill="var(--butter)" stroke="var(--plum)" stroke-width="2.5" />
      <path d="M 175 340 Q 205 295 235 330 T 290 315" fill="none" stroke="var(--brick)" stroke-width="3.5" stroke-linecap="round" />
      <text x="230" y="385" text-anchor="middle" font-family="Figtree, sans-serif" font-weight="700" font-size="13" fill="var(--plum)">
        [PHOTO SLOT]
      </text>
      <text x="230" y="406" text-anchor="middle" font-family="Figtree, sans-serif" font-weight="600" font-size="11.5" fill="var(--muted)">
        {photoCaption}
      </text>
      <text x="230" y="430" text-anchor="middle" font-family="Figtree, sans-serif" font-weight="600" font-size="11" fill="var(--muted)">
        Bonn · Madeira · Eskişehir
      </text>
    </svg>
  </div>
) : (
  <svg viewBox="0 0 500 250" class="arches-decoration" aria-hidden="true">
    <path d="M 10 250 A 240 240 0 0 1 490 250 Z" fill="var(--rose)" stroke="var(--plum)" stroke-width="2.5" />
    <path d="M 55 250 A 195 195 0 0 1 445 250 Z" fill="var(--peach)" stroke="var(--plum)" stroke-width="2.5" />
    <path d="M 100 250 A 150 150 0 0 1 400 250 Z" fill="var(--butter)" stroke="var(--plum)" stroke-width="2.5" />
    <path d="M 145 250 A 105 105 0 0 1 355 250 Z" fill="var(--mint)" stroke="var(--plum)" stroke-width="2.5" />
    <path d="M 190 250 A 60 60 0 0 1 310 250 Z" fill="var(--lilac)" stroke="var(--plum)" stroke-width="2.5" />
  </svg>
)}

<style>
  .arches-hero {
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
  }

  .arches-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(6px 6px 0 var(--plum));
  }

  .arches-decoration {
    width: 100%;
    max-width: 360px;
    height: auto;
  }
</style>
