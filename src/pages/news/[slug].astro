---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article>
    <header class="page-hero band-mint">
      <div class="container page-hero-inner">
        <div class="article-stamps">
          <Stamp text={formattedDate} variant="brick" rotate={-1.5} />
          <Stamp text={post.data.city} variant="dashed" fill="paper" rotate={1.5} />
        </div>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.summary}</p>
      </div>
    </header>

    <div class="section-band band-paper">
      <div class="container">
        <div class="article-card">
          {post.data.image && (
            <figure class="article-figure">
              <Image
                src={post.data.image}
                alt={post.data.imageAlt || post.data.title}
                widths={[480, 800, 1100]}
                sizes="(max-width: 800px) 100vw, 800px"
              />
              {post.data.imageAlt && (
                <figcaption>
                  {post.data.imageAlt} · Published with written participant consent.
                </figcaption>
              )}
            </figure>
          )}

          <div class="prose">
            <Content />
          </div>

          <div class="article-back">
            <a href="/news/" class="btn btn-butter">← Back to all news</a>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .article-card {
    max-width: 820px;
    background-color: var(--paper);
    border: var(--border-thick);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-hard);
  }

  .article-figure {
    margin: 0 0 1.75rem 0;
    border: 2px solid var(--plum);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--butter);
  }

  .article-figure img {
    width: 100%;
    height: auto;
  }

  .article-figure figcaption {
    padding: 0.65rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    border-top: 2px dashed var(--plum);
  }

  .article-back {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--plum);
  }
</style>
